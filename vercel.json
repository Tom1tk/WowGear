{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "25mb",
        "excludeFiles": "{frontend/**,data/raw/**,data/era/staging/**,data/era/sources.json,data/era/reference/**,reports/**,scripts/**,tasks/**,backend/tests/**}"
      }
    },
    { "src": "frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/static/(.*)", "dest": "/frontend/$1" },
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
